import arcpy
from arcpy import env
from arcpy.sa import *

#set workspace
arcpy.env.workspace = r"C:/URI_8.27.2024\PhD_8.27.2024\Projects\CHAMP\CHAMP\CHAMP GIS\Low Point Analysis\MyProject\MyProject.gdb"

# Read in the roads dataset and DEM
roads_fc = r"C:\URI_8.27.2024\PhD_8.27.2024\Projects\CHAMP\CHAMP\CHAMP GIS\Low Point Analysis\MyProject\MyProject.gdb\TRANS_Roads_E911_24r3"
dem_raster = r"C:\URI_8.27.2024\PhD_8.27.2024\Projects\CHAMP\CHAMP\CHAMP GIS\Low Point Analysis\MyProject\MyProject.gdb\DEM_Mosaic"

#Step 1: Select major roads only (local, state, highways, etc)s
arcpy.management.SelectLayerByAttribute(roads_fc, "NEW_SELECTION", where_clause="ST_Class in (3, 4, 20, 30, 40, 50, 52, 59, 91, 92)")

# Write selected features to a new feature class
arcpy.management.CopyFeatures(roads_fc, 'roads_rd')

#Step 2: Convert road dataset from multipart to single part data (Tool: multipart to single part)
#arcpy.management.MultipartToSinglepart('roads_rd', 'roads_sp')

#Step 3: Merge divided roads (tool: Merge Divided Roads)
#arcpy.cartography.MergeDividedRoads('roads_sp', merge_field = "ST_CLASS", merge_distance = "50 Feet", out_features= "roads_merge")

#Step 6: split line at intersections using Feature to Line
arcpy.management.FeatureVerticesToPoints(in_features='roads_rd', out_feature_class='roads_vertices', point_location="BOTH_ENDS")

#Step 7: Split line at vertices
arcpy.management.SplitLineAtPoint(in_features="roads_rd", point_features="roads_vertices", out_feature_class='roads_split')

#Step 4: Unsplit roads to merge segmented roads by dissolving on ST_FULL (Road Name) and MSAGComm_R ()
#arcpy.management.UnsplitLine(in_features='roads_split', out_feature_class='roads_unsplit', dissolve_field= ["ST_Full", "MSAGComm_R"])

#Step 5: Thin road network to include only roads greater than 500 feet in length
roads_reduce = arcpy.management.SelectLayerByAttribute(in_layer_or_view='roads_split', selection_type = "NEW_SELECTION", where_clause = '"Shape_Length" >= 500')

#Write selected features to a new feature class
arcpy.management.CopyFeatures(roads_reduce, out_feature_class= "roads_G500")

#Step 8: Generate a field to input a unique ID for each road segment
arcpy.management.AddField(in_table="roads_G500", field_name="ROAD_ID", field_type="FLOAT")

#Step 9; Define python expressions to generate sequential numbering for ID
expression = "autoIncrement()"
code_block = """
rec = 0
start = 1
interval = 1

def autoIncrement():
    global rec
    if rec == 0:
        rec = start
    else:
        rec += interval
    return rec
"""

#Step 9: Generate a unique ID for each segment as sequential number using calculate geometry
arcpy.management.CalculateField(in_table="roads_split", field="ROAD_ID", expression=expression, expression_type="PYTHON3", code_block=code_block)

#Step 9: Generate point every meter (50 feet) along a road. This is used to extract elevations from the DEM.
arcpy.management.GeneratePointsAlongLines(Input_Features='roads_split', Output_Feature_Class='road_pts_3ft', Point_Placement='DISTANCE', Distance= '3')

#Step 10: Export elevation from USGS 3DEP DEM
ExtractValuesToPoints(in_point_features="road_pts_3ft", in_raster=dem_raster, out_point_features="roads_pts_elev")

#Step 11: Identify minimum value for each section
stats_table = 'min_elev_stats'

arcpy.analysis.Statistics("roads_pts_elev", stats_table, [["RASTERVALU", "MIN"]], case_field="ROAD_ID")

#Step 12 - Join back to points
arcpy.management.JoinField('roads_pts_elev', "ROAD_ID", stats_table, "ROAD_ID", ["MIN_RASTERVALU"])

#Step 13 - select points where minimum raster value and raster value match
arcpy.management.SelectLayerByAttribute(in_layer_or_view="roads_pts_elev", selection_type="NEW_SELECTION", where_clause= '"RASTERVALU" = "MIN_RASTERVALU"')

#Write selected features to a new feature class
arcpy.management.CopyFeatures(in_features="roads_pts_elev", out_feature_class="roads_LPA")

